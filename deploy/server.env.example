# Copy snippets into /var/www/QuantDinger/.env (project root, NOT backend_api_python/.env)
#
# Layout:
#   /var/www/QuantDinger     — this repo (docker compose here)
#   /var/www/startlink-web   — Vue frontend source

FRONTEND_SRC_PATH=/var/www/startlink-web
FRONTEND_IMAGE=quantdinger-frontend
FRONTEND_TAG=local

# Do NOT set IMAGE_TAG=latest for local frontend builds (old GHCR habit).
# IMAGE_TAG only applies if you use docker-compose.ghcr.yml for prebuilt images.
